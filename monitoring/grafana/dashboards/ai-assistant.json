{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Enterprise AI Assistant — Application & Infrastructure Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "type": "stat",
      "title": "Backend Status",
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "auto" },
      "targets": [
        { "expr": "up{job=\"backend\"}", "legendFormat": "Backend", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "type": "stat",
      "title": "LangGraph Agent Status",
      "targets": [
        { "expr": "up{job=\"langgraph-agent\"}", "legendFormat": "LangGraph", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 3,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "type": "stat",
      "title": "Request Rate (5m)",
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "req/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": 0, "color": "green" }, { "value": 50, "color": "yellow" }, { "value": 100, "color": "red" }
          ]}
        }
      }
    },
    {
      "id": 4,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "type": "stat",
      "title": "Error Rate (5m)",
      "targets": [
        { "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) * 100", "legendFormat": "error %", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [
            { "value": 0, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 5, "color": "red" }
          ]}
        }
      }
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "type": "timeseries",
      "title": "HTTP Requests/sec by Endpoint",
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{path}} {{status_code}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "type": "timeseries",
      "title": "P50/P95/P99 Response Time (ms)",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m])) * 1000", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms",
        "thresholds": { "mode": "absolute", "steps": [
          { "value": 0, "color": "green" }, { "value": 1000, "color": "yellow" }, { "value": 3000, "color": "red" }
        ]}
      } }
    },
    {
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "type": "timeseries",
      "title": "CPU Usage by Service",
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=~\"backend|langgraph-agent\"}[5m]) * 100", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "type": "timeseries",
      "title": "Memory Usage (MB)",
      "targets": [
        { "expr": "process_resident_memory_bytes{job=~\"backend|langgraph-agent\"} / 1024 / 1024", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "megabytes" } }
    },
    {
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "type": "timeseries",
      "title": "Redis Operations/sec",
      "targets": [
        { "expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "ops/s", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "type": "timeseries",
      "title": "PostgreSQL Active Connections",
      "targets": [
        { "expr": "pg_stat_database_numbackends", "legendFormat": "{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [
          { "value": 0, "color": "green" }, { "value": 50, "color": "yellow" }, { "value": 80, "color": "red" }
        ]}
      } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["ai-assistant", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Enterprise AI Assistant",
  "uid": "ai-assistant-main",
  "version": 1
}
