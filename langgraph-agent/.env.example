# ── OpenAI / compatible gateway ──────────────────────────────────
OPENAI_API_KEY=your-key-here
OPENAI_API_BASE=              # leave blank for OpenAI cloud; set for internal gateway
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Tavily (web search) ───────────────────────────────────────────
TAVILY_API_KEY=your-tavily-key-here

# ── Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=               # leave blank for local instance
QDRANT_COLLECTION=chunks      # existing collection from enterprise-ai-assistant

# ── LangSmith (optional tracing) ─────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langgraph-agent

# ── App ───────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=7860
MAX_QUALITY_RETRIES=3

# ── MCP (Model Context Protocol) ──────────────────────────────────
# false = LangGraph calls Qdrant/Tavily directly (default, fastest)
# true  = LangGraph RAG/web nodes call tools through MCP client→server
USE_MCP_TOOLS=false
