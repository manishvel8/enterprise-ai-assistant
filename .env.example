# =============================================================================
# Enterprise AI Chat Assistant — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_assistant
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=change_me_in_production

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Qdrant (Vector DB) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=document_chunks

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_in_production

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ai-documents
MINIO_USE_SSL=false

# --- Langfuse (Observability) ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- FastAPI Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:4200,http://localhost:80

# --- Security ---
SECRET_KEY=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_OPENAI_CALLS=10

# --- Document Processing ---
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,docx,pptx,xlsx,csv,txt,png,jpg,jpeg,mp3,mp4,wav

# --- Feature Flags ---
ENABLE_GRAPH_RAG=true
ENABLE_STREAMING=true
ENABLE_DEBUG_PANEL=true
LOG_LEVEL=INFO
