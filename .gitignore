# =============================================================================
# Enterprise AI Chat Assistant — .gitignore
# =============================================================================

# Environment secrets — NEVER commit these
.env
*.env.local
*.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
env/
.venv/
pip-log.txt
.pytest_cache/
.coverage
htmlcov/
*.log

# Node / Angular
node_modules/
frontend/dist/
frontend/.angular/
*.js.map
npm-debug.log*
yarn-debug.log*

# Docker
*.tar

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Kubernetes secrets (generated)
k8s/secret-generated.yaml

# Uploaded documents (local dev)
uploads/
tmp/

# Test coverage
coverage/

# Celery
celerybeat-schedule
celerybeat.pid
